# Public site origin used for canonical URLs, sitemap, OG. Never change this because of the framework move.
NEXT_PUBLIC_SITE_URL=https://rasmwed.com

# Origin of the WordPress CMS (REST API + /wp-content/uploads media).
# Before DNS cutover, move WordPress to e.g. https://cms.rasmwed.com and set it here;
# /wp-content/uploads/* is rewritten to this origin so old media URLs keep working.
WP_ORIGIN=https://cms.rasmwed.com

# Set to "false" on staging/preview deployments to force noindex + Disallow: / (Vercel sets VERCEL_ENV automatically).
# NEXT_PUBLIC_ALLOW_INDEXING=false

# --- AI SEO agent (server-only, never NEXT_PUBLIC_) ---
OPENAI_API_KEY=
CRON_SECRET=
ADMIN_PASSWORD=
REVALIDATE_SECRET=
WP_URL=https://cms.rasmwed.com
WP_USERNAME=
WP_APP_PASSWORD=
# Posts are always created as drafts unless this is "true" AND the quality gate passes.
AI_AUTOPUBLISH=false
# Tracking (defaults are the IDs already on the live WordPress site)
# NEXT_PUBLIC_GA_ID=G-633JRXXMKW
# NEXT_PUBLIC_GOOGLE_TAG_ID=GT-TQDJTSP5
# NEXT_PUBLIC_META_PIXEL_ID=861960160150480
# NEXT_PUBLIC_GSC_VERIFICATION=

# Budget mode ($10/month). Defaults shown; text = gpt-6.1-sol, cheap tasks/fallback = gpt-6-luna, image = gpt-image-2.5-sunburst (medium, 1 per article).
# AI_MONTHLY_BUDGET_USD=10
# AI_DAILY_BUDGET_USD=0.6
# AI_MAX_IMAGES_PER_DAY=1
# AI_PRIMARY_MODEL=gpt-6.1-sol
# AI_FALLBACK_MODEL=gpt-6-luna
# AI_IMAGE_MODEL=gpt-image-2.5-sunburst
# AI_IMAGE_QUALITY=medium

# Agent state lives in the WordPress MySQL DB (private posts via core REST, no plugin needed)
AI_STORE=wordpress

# Programmatic SEO safety caps
# AI_PROGRAMMATIC_PER_WEEK=2
# AI_PROGRAMMATIC_MAX_TOTAL=40
